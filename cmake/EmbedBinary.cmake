# Build-time script (cmake -P): embed a kernel object as a C++ byte array.
# Inputs: INPUT, OUTPUT_CPP, NAME, PROVENANCE_FILE.
cmake_minimum_required(VERSION 3.26)

foreach(v INPUT OUTPUT_CPP NAME PROVENANCE_FILE)
  if(NOT DEFINED ${v})
    message(FATAL_ERROR "EmbedBinary: ${v} not set")
  endif()
endforeach()
if(NOT NAME MATCHES "^[A-Za-z_][A-Za-z0-9_]*$")
  message(FATAL_ERROR "EmbedBinary: '${NAME}' is not a valid C identifier")
endif()

file(READ "${INPUT}" hex HEX)
string(LENGTH "${hex}" hexlen)
math(EXPR size "${hexlen} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){16})" "\\1\n    " bytes "${bytes}")
file(SHA256 "${INPUT}" sha)
file(READ "${PROVENANCE_FILE}" prov)
string(REGEX REPLACE "[^A-Za-z0-9 .:_-]" "_" prov "${prov}")

set(code "// Generated by cmake/EmbedBinary.cmake from ${NAME}.o. Do not edit.
#include <cstddef>

extern \"C\" {
alignas(16) extern const unsigned char pcuda_kimg_${NAME}[] = {
    ${bytes}
};
extern const std::size_t pcuda_kimg_${NAME}_size = ${size};
extern const char pcuda_kimg_${NAME}_sha256[] = \"${sha}\";
extern const char pcuda_kimg_${NAME}_provenance[] = \"${prov}\";
}
")
file(WRITE "${OUTPUT_CPP}.tmp" "${code}")
file(COPY_FILE "${OUTPUT_CPP}.tmp" "${OUTPUT_CPP}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT_CPP}.tmp")
