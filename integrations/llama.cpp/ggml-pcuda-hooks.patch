diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index cad18408a..06e4542f5 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -2966,10 +2966,26 @@ llm_graph_cb llama_context::graph_get_cb() const {
         if (ubatch.n_tokens < 32 || full_offload) {
             if (il != -1 && (strcmp(name, "norm") == 0 || strcmp(name, "l_last") == 0)) {
                 const auto & dev_layer = model.dev_layer(il);
-                for (const auto & backend : backends) {
-                    if (ggml_backend_get_device(backend.get()) == dev_layer) {
-                        if (ggml_backend_supports_op(backend.get(), cur)) {
-                            ggml_backend_sched_set_tensor_backend(sched.get(), cur, backend.get());
+                // a CPU layer whose ops an ACCEL backend runs on the same host memory (e.g. PCUDA) keeps
+                // its norms on that backend, so the layer is not split around every norm
+                ggml_backend_t accel = nullptr;
+                if (ggml_backend_dev_type(dev_layer) == GGML_BACKEND_DEVICE_TYPE_CPU) {
+                    for (const auto & backend : backends) {
+                        if (ggml_backend_dev_type(ggml_backend_get_device(backend.get())) == GGML_BACKEND_DEVICE_TYPE_ACCEL &&
+                            ggml_backend_supports_op(backend.get(), cur)) {
+                            accel = backend.get();
+                            break;
+                        }
+                    }
+                }
+                if (accel) {
+                    ggml_backend_sched_set_tensor_backend(sched.get(), cur, accel);
+                } else {
+                    for (const auto & backend : backends) {
+                        if (ggml_backend_get_device(backend.get()) == dev_layer) {
+                            if (ggml_backend_supports_op(backend.get(), cur)) {
+                                ggml_backend_sched_set_tensor_backend(sched.get(), cur, backend.get());
+                            }
                         }
                     }
                 }
diff --git a/src/llama-model.cpp b/src/llama-model.cpp
index 81af8903f..6e56542d7 100644
--- a/src/llama-model.cpp
+++ b/src/llama-model.cpp
@@ -1614,6 +1614,20 @@ bool llama_model_base::load_tensors(llama_model_loader & ml) {
                 break;
             }
         }
+        // ACCEL devices take weights through the CPU buffer list (make_cpu_buft_list). One that
+        // copies them into its own memory (PCUDA) would otherwise keep a second, mapped copy of
+        // the whole file resident.
+        for (size_t i = 0; ml.use_mmap && i < ggml_backend_dev_count(); ++i) {
+            ggml_backend_dev_t dev = ggml_backend_dev_get(i);
+            if (ggml_backend_dev_type(dev) != GGML_BACKEND_DEVICE_TYPE_ACCEL) {
+                continue;
+            }
+            ggml_backend_dev_props props;
+            ggml_backend_dev_get_props(dev, &props);
+            if (!props.caps.mmap_support) {
+                ml.use_mmap = false;
+            }
+        }
     }
 
     // resolve AUTO on systems without mmap support (e.g. iGPUs): fall back to OFF; see #28160
