# Build-time script (cmake -P): copy freshly produced kath output into kernels/prebuilt with
# SHA-256 files and the hash of the (LF-normalised) source.
# Inputs: OBJ (--cpu object), MSL (--metal source), IR (--ir dump), NAME, DEST.
cmake_minimum_required(VERSION 3.26)

foreach(v OBJ MSL IR NAME DEST)
  if(NOT DEFINED ${v})
    message(FATAL_ERROR "RefreshPrebuilt: ${v} not set")
  endif()
endforeach()
if(NOT EXISTS "${OBJ}.srcsha256" OR NOT EXISTS "${MSL}.srcsha256")
  message(FATAL_ERROR "RefreshPrebuilt: ${NAME} has not been built yet")
endif()
foreach(f "${OBJ}" "${MSL}")
  file(READ "${f}.provenance" prov)
  if(prov MATCHES "^prebuilt:")
    message(FATAL_ERROR "RefreshPrebuilt: ${NAME} was itself taken from prebuilt; build with kath (exe or wsl mode)")
  endif()
endforeach()
file(READ "${OBJ}.srcsha256" ssha)
file(READ "${MSL}.srcsha256" msha)
if(NOT ssha STREQUAL msha)
  message(FATAL_ERROR "RefreshPrebuilt: ${NAME} object and Metal output come from different sources")
endif()
file(MAKE_DIRECTORY "${DEST}")
foreach(pair "${OBJ}=o" "${MSL}=metal" "${IR}=ir")
  string(REPLACE "=" ";" pair "${pair}")
  list(GET pair 0 src)
  list(GET pair 1 ext)
  file(COPY_FILE "${src}" "${DEST}/${NAME}.${ext}")
  file(SHA256 "${DEST}/${NAME}.${ext}" h)
  file(WRITE "${DEST}/${NAME}.${ext}.sha256" "${h}\n")
endforeach()
file(WRITE "${DEST}/${NAME}.cu.sha256" "${ssha}\n")
message(STATUS "prebuilt ${NAME} updated (.o .metal .ir)")
